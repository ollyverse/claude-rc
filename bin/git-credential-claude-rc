#!/bin/sh
# git credential helper: the fine-grained GitHub token for a repository's owner.
#
# Tokens are files named after the owner in $CLAUDE_RC_GITHUB_DIR (a Secret
# mount; default /etc/claude-rc/github). git calls this with the repository
# path only when credential.useHttpPath is true. Anything we don't know makes
# us print nothing, and git asks the next helper or fails on its own.
set -eu

[ "${1:-}" = "get" ] || exit 0
dir="${CLAUDE_RC_GITHUB_DIR:-/etc/claude-rc/github}"

host=""
path=""
while IFS= read -r line; do
    case "$line" in
        "") break ;;
        host=*) host="${line#host=}" ;;
        path=*) path="${line#path=}" ;;
    esac
done

[ "$host" = "github.com" ] || exit 0
owner="${path%%/*}"
case "$owner" in
    "" | . | .. | *[!A-Za-z0-9_.-]*) exit 0 ;;
esac
[ -f "$dir/$owner" ] || exit 0

printf 'username=x-access-token\npassword=%s\n' "$(cat "$dir/$owner")"
